# Copy this file to .env and fill in real values before running the project.

# --- Core Django ---
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# Leave blank to use local SQLite (default, good for development).
# For PostgreSQL (production), set e.g.:
# DATABASE_URL=postgres://hopcee_user:hopcee_pass@localhost:5432/hopcee_db
DATABASE_URL=

# --- Hopcee business contact numbers (shown across the site) ---
HOPCEE_WHATSAPP_NUMBER=+265988609202
HOPCEE_CALL_NUMBER=+265897470024
HOPCEE_REG_NUMBER=Available on Request

# --- WhatsApp Cloud API (Meta) ---
# Get these from https://developers.facebook.com/apps -> WhatsApp -> API Setup
# If left blank, the app falls back to generating wa.me click-to-chat links
# and simply logs the message instead of sending it, so the site still works
# fully in development without a WhatsApp Business account.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_ID=
WHATSAPP_API_VERSION=v20.0
